# Salin file ini ke `.env` lalu isi nilai sesuai environment Anda.
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env (Windows)

DATABASE_URL="mysql://root:PASSWORD@127.0.0.1:3306/indah_mesin"

AUTH_SECRET="ganti-dengan-secret-acak-panjang"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

NEXT_PUBLIC_APP_NAME="Indah Mesin"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NEXT_PUBLIC_WHATSAPP_ADMIN="628xxxxxxxxxx"
NEXT_PUBLIC_CONTACT_EMAIL="admin@example.com"

# Kunci akses login admin saat halaman /admin/login disembunyikan (superadmin).
# Bukan placeholder teks — isi nilai rahasia sendiri, lalu buka:
# http://localhost:3000/admin/login?access=nilai-rahasia-anda
ADMIN_LOGIN_ACCESS_KEY="ganti-dengan-kunci-rahasia-admin"

# Google OAuth (opsional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP notifikasi email (opsional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MesinBagus <no-reply@example.com>"
