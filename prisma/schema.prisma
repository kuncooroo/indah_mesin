generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// 1. ENUMERATIONS
// ==========================================

enum Role {
  BUYER
  PURCHASING
  APPROVER
  ADMIN
  SUPERADMIN
}

enum CompanyType {
  BUYER
  VENDOR
}

enum OrderStatus {
  DRAFT
  SUBMITTED_VIA_WA
  NEGOTIATING
  APPROVED
  CANCELLED
}

enum ArchiveDocumentType {
  PO_DRAFT
  OFFICIAL_QUOTATION
  INVOICE
  BROCHURE
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum StockStatus {
  READY_STOCK
  INDENT
  OUT_OF_STOCK
}

enum MediaType {
  IMAGE
  VIDEO
}

enum RfqStatus {
  PENDING
  PROCESSED
  QUOTATION_SENT
  CANCELLED
}

// ==========================================
// 2. COMPANIES & ADDRESSES
// ==========================================

model Company {
  id          String      @id @default(uuid())
  companyName String
  type        CompanyType @default(BUYER)
  npwpNumber  String?
  nibNumber   String?
  isVerified  Boolean     @default(false)

  users     User[]
  addresses CompanyAddress[]
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isVerified])
}

model CompanyAddress {
  id            String  @id @default(uuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label         String
  addressDetail String  @db.Text
  city          String
  postalCode    String?
  isPrimary     Boolean @default(false)

  ordersAsShipping Order[]

  @@index([companyId])
}

// ==========================================
// 3. USER MANAGEMENT (PIC)
// ==========================================

model User {
  id                 String             @id @default(uuid())
  username           String?            @unique
  customBuyerId      String?            @unique
  name               String
  email              String             @unique
  password           String
  phone              String?
  avatar             String?            @db.Text

  companyId          String?
  company            Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)

  role               Role               @default(BUYER)
  verificationStatus VerificationStatus @default(UNVERIFIED)

  /// Legacy — prefer `company` relation
  companyName        String?
  companyAddress     String?            @db.Text
  position           String?

  savedItems         SavedItem[]
  cartItems          CartItem[]
  rfqRequests        RfqRequest[]
  orders             Order[]
  archiveDocuments   ArchiveDocument[]
  activityLogs       ActivityLog[]

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([companyId])
  @@index([role])
}

// ==========================================
// 3. PRODUCT CATALOG
// ==========================================

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  logo     String?   @db.Text
  products Product[]
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  icon      String?
  parentId  String?
  parent    Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToParent")
  products  Product[]
  createdAt DateTime   @default(now())
}

model Product {
  id          String      @id @default(uuid())
  sku         String      @unique
  name        String
  slug        String      @unique
  stockStatus StockStatus @default(READY_STOCK)
  indentDays  Int?
  isPublished Boolean     @default(true)

  currency     String  @default("IDR")
  price        Decimal @db.Decimal(15, 2) /// price_estimate
  priceNote    String? @db.Text
  brochureUrl  String? @db.Text
  sopUrl       String? @db.Text

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  brandId    String?
  brand      Brand?   @relation(fields: [brandId], references: [id])

  media          ProductMedia[]
  features       ProductFeature[]
  documents      ProductDocument[]
  specifications ProductSpecification[]
  savedByUsers   SavedItem[]
  cartItems      CartItem[]
  rfqItems       RfqItem[]
  orderItems     OrderItem[]
  reviews        ProductReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isPublished])
}

model ProductMedia {
  id        String    @id @default(uuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String    @db.Text
  type      MediaType @default(IMAGE)
  isPrimary Boolean   @default(false)
  sortOrder Int       @default(0)
}

model ProductFeature {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  text      String  @db.Text
  sortOrder Int     @default(0)
}

model ProductDocument {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title     String
  subtitle  String?
  fileUrl   String  @db.Text
}

model ProductSpecification {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute String
  value     String  @db.Text
  sortOrder Int     @default(0)
}

// ==========================================
// 4. BUYER INTERACTIONS
// ==========================================

model SavedItem {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  variant   String?
  note      String?  @db.Text
  createdAt DateTime @default(now())
}

// ==========================================
// 5. RFQ
// ==========================================

model RfqRequest {
  id             String    @id @default(uuid())
  rfqNumber      String    @unique
  picName        String
  companyName    String
  phoneNumber    String
  companyAddress String    @db.Text
  totalEstimated Decimal   @db.Decimal(15, 2)
  status         RfqStatus @default(PENDING)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  items RfqItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RfqItem {
  id           String     @id @default(uuid())
  rfqRequestId String
  rfqRequest   RfqRequest @relation(fields: [rfqRequestId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])

  productName String
  productSku  String
  quantity    Int
  variant     String?
  price       Decimal @db.Decimal(15, 2)
  note        String? @db.Text
}

// ==========================================
// 5b. ORDERS (Draf PO & transaksi)
// ==========================================

model Order {
  id                  String      @id @default(uuid())
  orderNumber         String      @unique
  userId              String?
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId           String?
  company             Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  status              OrderStatus @default(DRAFT)
  totalEstimatedPrice Decimal     @db.Decimal(15, 2)
  shippingAddressId   String?
  shippingAddress     CompanyAddress? @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  notes               String?     @db.Text

  items     OrderItem[]
  documents ArchiveDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Int     @default(1)
  priceAtTime Decimal @db.Decimal(15, 2)

  @@index([orderId])
  @@index([productId])
}

model ArchiveDocument {
  id           String              @id @default(uuid())
  userId       String?
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId      String?
  order        Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  documentName String
  documentType ArchiveDocumentType
  fileUrl      String              @db.Text
  createdAt    DateTime            @default(now())

  @@index([userId])
  @@index([orderId])
  @@index([documentType])
}

// ==========================================
// 6. AUDIT
// ==========================================

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())
}

// ==========================================
// 7. CMS / SHOP (tetap dipakai storefront)
// ==========================================

model Article {
  id          String   @id @default(uuid())
  slug        String   @unique
  category    String
  title       String
  excerpt     String?  @db.Text
  body        String?  @db.LongText
  imageUrl    String   @db.Text
  publishedAt DateTime
  readMinutes Int      @default(5)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id                 String  @id @default("default")
  brandName          String
  phoneDisplay       String
  phoneTel           String
  email              String
  salesEmail         String
  showroomHeroImage  String? @db.Text
  mapImageUrl        String? @db.Text
  hoursWeekdayLabel  String?
  hoursWeekdayValue  String?
  hoursSaturdayLabel String?
  hoursSaturdayValue String?
  hoursSundayLabel   String?
  hoursSundayValue   String?
  headOfficeTitle    String?
  headOfficeLines    Json?
  showroomTitle      String?
  showroomLines      Json?
}

model QuickFilter {
  id        String  @id @default(uuid())
  label     String  @unique
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

model Faq {
  id        String   @id @default(uuid())
  question  String   @db.VarChar(500)
  answer    String   @db.Text
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductReview {
  id         String   @id @default(uuid())
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int      @default(5)
  content    String   @db.Text
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
